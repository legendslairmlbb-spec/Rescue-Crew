# OpenRouter (copy to .env, which git ignores)
OPENROUTER_API_KEY=sk-or-v1-your-key
# Model called first, then the fallbacks in order if it is rate-limited or unavailable
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODELS=baidu/ernie-5.5-flash-preview:free,nvidia/nemotron-3.5-super-vl:free
