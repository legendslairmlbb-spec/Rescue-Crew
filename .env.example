# LLM endpoint (copy to .env, which git ignores). Any OpenAI-compatible endpoint works.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-key
# Model called first, then the fallbacks in order if it is rate-limited or unavailable
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_FALLBACK_MODELS=baidu/ernie-5.5-flash-preview:free,nvidia/nemotron-3.5-super-vl:free
